# Copy this file to .env and fill in your real key.
# .env is git-ignored — never commit real secrets.

# LLM mode:
#   mock   -> free, local, canned SQL answers for a handful of known
#             questions (see backend/mock_llm.py). No OpenAI call is made
#             and no API key is required. Good for developing/testing the
#             rest of the pipeline without an OpenAI budget.
#   openai -> the real model, using OPENAI_API_KEY and OPENAI_MODEL below.
#   ollama -> a local model via Ollama, using OLLAMA_MODEL and
#             OLLAMA_BASE_URL below. No API key, but Ollama must actually
#             be running (`ollama serve`) with the model pulled
#             (`ollama pull qwen3:4b`).
#   gemini -> Google's Gemini API, using GEMINI_API_KEY, GEMINI_MODEL and
#             GEMINI_EMBED_MODEL below. This is the only mode where
#             RETRIEVAL embeddings also go to the cloud (Gemini) instead of
#             a local Ollama model — see GEMINI_EMBED_MODEL below.
SQLGENIE_LLM_MODE=mock

# Your OpenAI API key (https://platform.openai.com/api-keys)
# Only required when SQLGENIE_LLM_MODE=openai.
OPENAI_API_KEY=sk-your-key-here

# Which OpenAI chat model generates the SQL. Easy to change later —
# nothing else in the code needs to change.
OPENAI_MODEL=gpt-5.6-luna

# Which locally-pulled Ollama model generates the SQL. Only used when
# SQLGENIE_LLM_MODE=ollama.
OLLAMA_MODEL=qwen3:4b

# Ollama's own HTTP API. Only used when SQLGENIE_LLM_MODE=ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Which locally-pulled Ollama model embeds schema/question text for
# retrieval (backend/schema_retrieval.py). Used for retrieval in every mode
# EXCEPT "gemini" (which uses GEMINI_EMBED_MODEL below instead). Pull it
# first: `ollama pull nomic-embed-text:latest`.
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Your Gemini API key (https://aistudio.google.com/apikey). Only required
# when SQLGENIE_LLM_MODE=gemini. Never commit a real key — this file is a
# template with no secrets; your real .env is git-ignored.
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model generates and corrects SQL. Only used when
# SQLGENIE_LLM_MODE=gemini. Verified against Google's current model list at
# the time this was added — check https://ai.google.dev/gemini-api/docs/models
# if API calls start failing with a "model not found" error, since Google
# periodically deprecates older model IDs.
GEMINI_MODEL=gemini-3.6-flash

# Which Gemini model embeds schema/question text for retrieval. Only used
# when SQLGENIE_LLM_MODE=gemini (every other mode uses OLLAMA_EMBED_MODEL
# above instead). Same verify-before-relying-on-it note as GEMINI_MODEL.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Which dataset profile (see backend/dataset.py) describes the database.
# The frontend uses it to pick a visual theme. Only "olist" exists today.
SQLGENIE_DATASET=olist

# Origins (comma-separated) whose browser JavaScript may call this API.
# Needed because the frontend runs on a different port/domain than the
# backend. The default below is local dev only (5173 is Vite's default
# port; 8080 is where the Day 9 Lovable frontend runs). When the real
# frontend is deployed, replace it with the exact deployed origin, e.g.
# https://my-app.example.com — avoid "*", which lets any website call this
# API from a visitor's browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Path to the SQLite database built in Day 1, relative to the project root.
DATABASE_PATH=database/olist.db

# Where uploaded CSVs (converted to SQLite) are stored, relative to the
# project root. Git-ignored entirely — this is runtime user data, not
# project source. See backend/csv_upload.py.
UPLOADS_DIR=uploads

# Max size of an uploaded CSV, in bytes. Default 5 MB (5 * 1024 * 1024).
CSV_UPLOAD_MAX_BYTES=5242880

# Safety cap: max rows returned by any query. Also used to auto-append a
# LIMIT clause when the generated SQL doesn't already have one.
MAX_ROWS=200

# Abort a query if it runs longer than this many seconds (guards against a
# runaway query, e.g. an accidental cross join).
QUERY_TIMEOUT_SECONDS=10

# --- Public API protection ---

# Max characters allowed in one /ask question. A natural-language question
# never legitimately needs to be long; this just bounds the one free-text
# field a public deployment exposes.
MAX_QUESTION_LENGTH=500

# Per-client-IP request budgets (requests per minute) for the two endpoints
# that actually cost money/compute to serve — see backend/rate_limit.py.
# Generous enough for normal interactive use, tight enough that a script
# hammering the API from one IP can't run up a Gemini bill or Render CPU
# bill.
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
# /datasets/{id}/select and /debug/retrieve can each trigger an embedding
# call too (see backend/schema_retrieval.py's init_documents()).
RATE_LIMIT_SELECT_PER_MINUTE=10
RATE_LIMIT_DEBUG_PER_MINUTE=10

# Hard ceiling (bytes) on any single request body, enforced before
# FastAPI/Starlette ever buffers it — a backstop against a grossly
# oversized request, independent of CSV_UPLOAD_MAX_BYTES above. Leave unset
# to default to CSV_UPLOAD_MAX_BYTES + 5 MB (room for multipart overhead),
# so a legitimately-sized CSV still gets csv_upload.py's own clearer error
# instead of this blunter one.
# MAX_REQUEST_BODY_BYTES=10485760

# ALL rate limits above assume this app runs as ONE instance with ONE
# worker process (see backend/rate_limit.py's SlidingWindowRateLimiter
# docstring) — its state is per-process memory, with no coordination
# across processes. Do not run with `--workers N > 1`, and be aware that
# scaling to multiple Render instances would multiply every limit above by
# the instance count, not enforce it globally.

# Whether backend/rate_limit.py's get_client_ip() reads X-Forwarded-For at
# all. False (default) means it NEVER does — only the raw TCP peer is ever
# used, so a client-supplied header has zero effect, which is the safe
# default for local dev and for any deployment whose proxy topology isn't
# a known quantity. Set to true ONLY when this app runs behind exactly one
# reverse proxy you trust to set this header correctly (intended for
# Render) — this is a documented assumption to verify against a real
# deployment, not a confirmed fact about any specific platform; see
# get_client_ip()'s docstring before enabling it.
TRUST_PROXY_HEADERS=false

# Enables GET /debug/retrieve, a development-only endpoint that shows
# which tables retrieval would pick for a question (see backend/main.py).
# False (default) in EVERY environment, not just "production" — there is
# no separate environment concept in this app. Leave this false on any
# public deployment: it calls the same embedding model /ask does (a real
# Gemini API call in "gemini" mode) and, enabled, has no purpose beyond
# local debugging.
ENABLE_DEBUG_ENDPOINTS=false
