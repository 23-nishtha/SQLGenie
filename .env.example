# Copy this file to .env and fill in your real key.
# .env is git-ignored — never commit real secrets.

# LLM mode:
#   mock   -> free, local, canned SQL answers for a handful of known
#             questions (see backend/mock_llm.py). No OpenAI call is made
#             and no API key is required. Good for developing/testing the
#             rest of the pipeline without an OpenAI budget.
#   openai -> the real model, using OPENAI_API_KEY and OPENAI_MODEL below.
SQLGENIE_LLM_MODE=mock

# Your OpenAI API key (https://platform.openai.com/api-keys)
# Only required when SQLGENIE_LLM_MODE=openai.
OPENAI_API_KEY=sk-your-key-here

# Which OpenAI chat model generates the SQL. Easy to change later —
# nothing else in the code needs to change.
OPENAI_MODEL=gpt-5.6-luna

# Path to the SQLite database built in Day 1, relative to the project root.
DATABASE_PATH=database/olist.db

# Safety cap: max rows returned by any query. Also used to auto-append a
# LIMIT clause when the generated SQL doesn't already have one.
MAX_ROWS=200

# Abort a query if it runs longer than this many seconds (guards against a
# runaway query, e.g. an accidental cross join).
QUERY_TIMEOUT_SECONDS=10
