# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Environment variables / API keys
.env
.env.*
# ...except the committed template (documents required vars, holds no secrets)
!.env.example

# Raw datasets
database/raw/
database/*/raw/

# User-uploaded datasets (Day 7): converted SQLite files, never committed —
# these are runtime data a user supplied, not project source.
uploads/

# SQLite databases
*.db
*.sqlite
*.sqlite3
# ...except the two small built-in datasets, committed directly (football
# ~9 MB, movies ~0.5 MB -- both well under GitHub's 100 MB limit). Olist
# (~183 MB) is NEVER committed, even with this exception: it's fetched at
# Render build time by scripts/fetch_olist_db.py and verified against
# database/olist.db.sha256 (see the README's deployment section).
!database/football/football.db
!database/movies/movies.db

# Node
node_modules/

# Build files
dist/
build/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db